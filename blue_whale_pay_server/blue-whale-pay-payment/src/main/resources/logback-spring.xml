<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="false" debug="false">

    <!-- 日志存放路径, 读取application.yml 需要使用springProperty获取 -->
    <springProperty scope="context" name="currentLoggerFilePath" source="logging.path"/>

    <!-- 主日志级别配置  -->
    <springProperty scope="context" name="currentRootLevel" source="logging.level.root"/>

    <!-- 项目配置， 如修改包名，请搜索并全部替换掉  -->
    <springProperty scope="context" name="currentProjectLevel" source="logging.level.com.blue.whale.pay"/>

    <!-- 火山引擎TLS日志上报参数（读取 application.yml 的 isys.tls; 凭证不全时 TlsLogAppender 自动跳过上报） -->
    <springProperty scope="context" name="tlsEndpoint" source="isys.tls.endpoint" defaultValue=""/>
    <springProperty scope="context" name="tlsRegion" source="isys.tls.region" defaultValue=""/>
    <springProperty scope="context" name="tlsTopicId" source="isys.tls.topic-id" defaultValue=""/>
    <springProperty scope="context" name="tlsAccessKey" source="isys.tls.access-key" defaultValue=""/>
    <springProperty scope="context" name="tlsSecretKey" source="isys.tls.secret-key" defaultValue=""/>
    <springProperty scope="context" name="tlsContainer" source="isys.tls.container" defaultValue="blue-whale-pay"/>
    <springProperty scope="context" name="tlsEnv" source="isys.tls.env" defaultValue="dev"/>
    <springProperty scope="context" name="tlsVersion" source="isys.tls.version" defaultValue=""/>

    <!-- 日志文件名称  logback属性 -->
    <property name="currentLoggerFileName" value="pay" />
    <!-- 日志格式, 参考：https://logback.qos.ch/manual/layouts.html ； [%X{trace_id}] 为跨系统链路标识（见 TraceIdFilter） -->
    <property name="currentLoggerPattern" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [%X{trace_id}] [%logger{15}] - %msg%n" />

    <!-- appender： 控制台日志 -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder charset="UTF-8" >
            <pattern>${currentLoggerPattern}</pattern>
        </encoder>
    </appender>

    <!-- appender：主日志文件 -->
    <appender name="ALL_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- 日志文件路径及文件名 -->
        <file>${currentLoggerFilePath}/${currentLoggerFileName}.all.log</file>
        <!-- 内容编码及格式 -->
        <encoder charset="UTF-8" ><pattern>${currentLoggerPattern}</pattern></encoder>
        <!-- 日志记录器的滚动策略，按日期，按大小记录 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- 每天日志归档路径以及格式 -->
            <fileNamePattern>${currentLoggerFilePath}/${currentLoggerFileName}.all.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>10</maxHistory> <!--日志文件保留天数-->
        </rollingPolicy>
    </appender>

    <!-- appender：错误信息日志文件 -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- 日志文件路径及文件名 -->
        <file>${currentLoggerFilePath}/${currentLoggerFileName}.error.log</file>
        <!-- 内容编码及格式 -->
        <encoder charset="UTF-8" ><pattern>${currentLoggerPattern}</pattern></encoder>
        <!-- 日志记录器的滚动策略，按日期，按大小记录 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- 每天日志归档路径以及格式 -->
            <fileNamePattern>${currentLoggerFilePath}/${currentLoggerFileName}.error.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>20</maxHistory> <!--日志文件保留天数-->
        </rollingPolicy>
        <!-- 此日志文件只记录ERROR级别的 -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
    </appender>

    <!-- appender：火山引擎TLS日志上报（字段Schema与blue-whale-api严格一致, 含caller/func） -->
    <appender name="TLS" class="com.blue.whale.pay.core.logging.TlsLogAppender">
        <endpoint>${tlsEndpoint}</endpoint>
        <region>${tlsRegion}</region>
        <topicId>${tlsTopicId}</topicId>
        <accessKey>${tlsAccessKey}</accessKey>
        <secretKey>${tlsSecretKey}</secretKey>
        <container>${tlsContainer}</container>
        <env>${tlsEnv}</env>
        <version>${tlsVersion}</version>
    </appender>

    <!-- 主日志级别配置 -->
    <root level="${currentRootLevel}">
        <appender-ref ref="STDOUT" />
        <appender-ref ref="ALL_FILE" />
        <appender-ref ref="ERROR_FILE" />
        <appender-ref ref="TLS" />
    </root>

    <!-- 项目日志级别配置 -->
    <logger name="com.blue.whale.pay" level="${currentProjectLevel}"/>

</configuration>
